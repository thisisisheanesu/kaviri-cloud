# Copy to docker/pins.env by running:
#
#   ./docker/resolve-pins.sh > docker/pins.env
#
# The values are deliberately empty here rather than filled in with plausible looking
# version numbers. A version copied out of a README is a version nobody checked, and a
# browser pin that does not correspond to a real package fails at build time with a
# confusing apt error rather than at review time with an obvious one.
BASE_IMAGE=
CHROMIUM_VERSION=
FFMPEG_VERSION=
KAVIRI_REF=
