# Copy to .env.local, fill it in, and never commit it. Secrets are read from the
# environment at runtime and never written to a file that ships.

# none    every tenant is unmetered, and the private billing service is not consulted.
#         This is the default and the mode the open repository is tested in.
# remote  org_entitlements is authoritative and is written by the private service.
BILLING_MODE=none

# Supabase, the dedicated kaviri-cloud project in eu-central-1.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Used only to mint the short-lived role JWTs described in docs/API.md. It is not handed
# to the render fleet and it does not appear in any Worker that serves customer traffic.
SUPABASE_JWT_SECRET=

# Cloudflare R2, artifact storage. These belong to the render fleet, which is the only
# component that writes objects. The api Worker holds no R2 credential at all: it mints a
# path-signed link for the dl Worker instead of presigning against R2 itself.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Artifact delivery. The signing key must be byte for byte identical in the api Worker and
# the dl Worker, or every artifact link the API mints is a 403 from the download host.
# DL_SIGNING_KEY_PREVIOUS verifies only, and exists so a rotation does not break links
# already pasted into READMEs.
DL_ORIGIN=https://dl.kaviri.dev
DL_SIGNING_KEY=
DL_SIGNING_KEY_PREVIOUS=

# The render fleet. One Hetzner box at launch, behind the queue.
# The worker holds this and nothing else: it is a JWT with role kaviri_worker, which can
# execute lease_next_job, report_progress and complete_job and can read no table at all.
KAVIRI_WORKER_JWT=
KAVIRI_WORKER_ID=
# Seconds. Keep the heartbeat at roughly an eighth of this.
KAVIRI_LEASE_SECONDS=120

# The rest of the render worker's configuration. The full table, with the defaults and the
# reason each one exists, is in render-worker/README.md.
# The container image one take runs inside. Built by docker/build.sh; pinned, because an
# unpinned base image silently changes what a take is filmed with.
KAVIRI_RENDER_IMAGE=kaviri-render:local
# Absolute, and on a filesystem with room for the frame spool plus the CFR intermediate.
KAVIRI_WORK_ROOT=/var/lib/kaviri/work
# The docker network docker/egress.sh creates. Without it the egress fence is not applied.
KAVIRI_DOCKER_NETWORK=kaviri-egress
# How many takes this box films at once, and the wall clock ceiling the box imposes on top
# of whatever the lease says.
KAVIRI_MAX_CONCURRENT_JOBS=2
KAVIRI_JOB_SECONDS_CAP=1800
KAVIRI_MIN_FREE_BYTES=10737418240
# Keep the heartbeat at roughly an eighth of KAVIRI_LEASE_SECONDS: the worker refuses a
# heartbeat that could not survive one lost beat.
KAVIRI_HEARTBEAT_SECONDS=15
